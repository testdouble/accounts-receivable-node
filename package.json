{
  "name": "accounts-receivable",
  "version": "0.1.0",
  "private": true,
  "description": "Accounts Receivable - an Express + TypeScript JSON API for creating and tracking invoices",
  "type": "module",
  "engines": {
    "node": "^26.13.0"
  },
  "scripts": {
    "start": "node src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.ts",
    "seed": "node src/seed.ts",
    "test": "vitest run",
    "lint": "./lint.sh"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "swagger-ui-dist": "5.34.1",
    "zod": "4.6.7",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
